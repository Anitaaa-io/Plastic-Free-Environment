# Plastic Free Environment - Environment Configuration Template
# Backend Configuration
DJANGO_SECRET_KEY=production-secure-random-key-replace-in-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1,https://plastic-free-environment.vercel.app

# Database Configuration
# In production on Render/Railway, DATABASE_URL is automatically provided by the managed PostgreSQL service:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_ENGINE=sqlite

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://plastic-free-environment.vercel.app,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# Frontend Configuration (set in Vercel project environment variables)
VITE_API_URL=https://plastic-free-backend.onrender.com/api
