# Plastic Free Environment - Environment Configuration Template
# Copy this file to .env and fill in real values

DJANGO_SECRET_KEY=replace-with-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set DB_ENGINE=postgresql for PostgreSQL or DB_ENGINE=sqlite for local SQLite
DB_ENGINE=sqlite
DB_NAME=plastic_free_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

