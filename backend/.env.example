# Django Settings
DJANGO_SECRET_KEY=production-secure-random-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set DB_ENGINE=postgresql to use PostgreSQL, or leave as sqlite for local development
DB_ENGINE=sqlite

# PostgreSQL Credentials (when DB_ENGINE=postgresql)
DB_NAME=plastic_free_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

